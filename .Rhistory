library(tidyverse)
library(janitor)
data<-read_csv("data/raw/manufacturing_quality.csv")
clean_data<-data
clean_data<-clean_data%>%
clean_names()
names(clean_data)
str(clean_data)
clean_data$type<-as.factor(clean_data$type)
str(clean_data)
colSums(is.na(clean_data))
sum(duplicated(clean_data))
write_csv(clean_data, "data/processed/manufacturing_quality_clean.csv")
