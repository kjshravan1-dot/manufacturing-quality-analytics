mutate(
tool_wear_level = case_when(
tool_wear_min < 100 ~ "Low",
tool_wear_min < 200 ~ "Medium",
)
)
clean_data <- clean_data %>%
mutate(
tool_wear_level = case_when(
tool_wear_min < 100 ~ "Low",
tool_wear_min < 200 ~ "Medium",
TRUE ~ "High"
)
)
table(clean_data$tool_wear_level)
write.csv(
clean_data,
"data/processed/manufacturing_quality_clean.csv"
)
