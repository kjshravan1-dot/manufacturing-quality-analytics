numeric_data <- clean_data %>%
select(where(is.numeric))
cor_matrix <- cor(numeric_data)
round(cor_matrix, 2)
write.csv(cor_matrix,
"reports/correlation_matrix.csv",
row.names = TRUE)
View(cor_matrix)
